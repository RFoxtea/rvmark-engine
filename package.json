{
  "name": "rvmark",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "rvmark engine — interactive tree-based document runtime and static site generator.",
  "bin": {
    "rvmark": "./bin/rvmark.mjs"
  },
  "exports": {
    "./build": {
      "import": "./build/build-rvmark.mjs"
    },
    "./envoy": {
      "types": "./out/envoy-guest.d.ts",
      "import": "./out/envoy-guest.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "build/",
    "out/",
    "scripts/watch.mjs",
    "scripts/static-server.mjs",
    "src/template.html",
    "src/styles.css",
    "src/types/*.css"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node build/build.mjs --test && playwright test --config playwright.config.js",
    "prepare": "node build/build.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "fast-xml-parser": "^5.4.1",
    "marked": "^15.0.12",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "ts-morph": "^28.0.0"
  }
}
