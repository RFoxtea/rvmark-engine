{title: Other Fixture; author: other-author}

1. {#other-root; open} Other file root
  1. {#other-child} Other file child
    1. {#other-grandchild} Other file grandchild
    2. {#other-grandchild-2} Other file grandchild 2
    3. Other grandchild no-slug A
    4. Other grandchild no-slug B
  2. {#other-child-2} Other file child 2
    1. Other child-2 grandchild no-slug
  3. {#other-root-ai} [GlobalAI] AI-tagged child of other-root
  4. {#other-mixed-host; open; => ./searchable-dir/#search-dir-root}

2. {#other-container} Container in other file
  1. {#other-ai-node} [GlobalAI] AI-tagged node in other file
    1. {#other-ai-child} Child of AI-tagged node in other file

3. {#pass-read-target} Pass read-only target
  1. {#pass-read-anchor} pass-read-anchor
  2. {#pass-read-indicator; show-when: &passvar == 1} pass-read-visible

4. {#pass-blocked-target} Pass blocked target
  1. {#pass-blocked-anchor} pass-blocked-anchor
  2. {#pass-blocked-indicator; show-when: &passvar == 1} pass-blocked-visible

5. {#pass-rw-target} Pass read-write target
  1. {#pass-rw-indicator; show-when: &passvar == 1} pass-rw-visible
  2. {#pass-rw-writer; on-action: set &passvar = 1} pass-rw-writer

6. {#pass-wo-target} Pass write-only target
  1. {#pass-wo-blocked-indicator; show-when: &passvar == 1} pass-wo-blocked-visible
  2. {#pass-wo-writer; on-action: set &passvar = 1} pass-wo-writer

7. {#pass-rename-target} Pass rename target
  1. {#pass-rename-indicator; show-when: &remotevar == 1} pass-rename-visible

8. {#pass-dash-target} Pass double-dash target
  1. {#pass-dash-indicator; show-when: &--dashvar == 1} pass-dash-visible
  2. {#pass-dash-write-node; on-action: set &--dashvar = 99} pass-dash-write-attempt

9. {#pass-sidepanel-target} Pass sidepanel target
  1. {#pass-sidepanel-indicator; show-when: &exvar == 1} pass-sidepanel-visible
  2. {#pass-sidepanel-writer; on-action: set &exvar = 1} pass-sidepanel-writer

10. {#pass-sidepanel-blocked-target} Pass sidepanel blocked target
  1. {#pass-sidepanel-blocked-indicator; show-when: &exvar == 1} pass-sidepanel-blocked-visible

11. {#pass-r-write-blocked-target} Pass r-only write-blocked target
  1. {#pass-r-write-blocked-writer; on-action: set &passvar = 1} pass-r-write-blocked-writer

12. {#pass-multi-target} Pass multi-var target
  1. {#pass-multi-avar-indicator; show-when: &avar == 1} pass-multi-avar-visible
  2. {#pass-multi-bvar-writer; on-action: set &bvar = 1} pass-multi-bvar-writer

13. {#pass-unknown-key-target} Pass unknown key target
  1. {#pass-unknown-key-indicator; show-when: &unknownvar == 1} pass-unknown-key-visible

14. {#pass-sidepanel-rename-target} Pass sidepanel rename target
  1. {#pass-sidepanel-rename-indicator; show-when: &exvar == 1} pass-sidepanel-rename-visible
  2. {#pass-sidepanel-rename-writer; on-action: set &exvar = 1} pass-sidepanel-rename-writer

15. {#pass-sidepanel-preroot-target} Pass sidepanel preroot target
  1. {#pass-sidepanel-preroot-indicator; show-when: &prerootvar == 1} pass-sidepanel-preroot-visible

